<%# encoding: ASCII -%>
#include "parser_prettyprint.h"
#include "ruby/internal/symbol.h"
#include "prism/internal/buffer.h"
#include "prism/internal/integer.h"

// We optionally support pretty printing nodes. For systems that don't want or
// need this functionality, it can be turned off with the
// PRISM_EXCLUDE_PRETTYPRINT define.
#ifdef PRISM_EXCLUDE_PRETTYPRINT

void rb_parser_prettyprint(void) {}

#else

static inline void
prettyprint_location(pm_buffer_t *output_buffer, const rb_code_location_t *location) {
    rb_code_position_t start = location->beg_pos;
    rb_code_position_t end = location->end_pos;
    pm_buffer_append_format(output_buffer, "(%" PRIi32 ",%" PRIi32 ")-(%" PRIi32 ",%" PRIi32 ")", start.lineno, start.column, end.lineno, end.column);
}

static inline void
prettyprint_constant(pm_buffer_t *output_buffer, const ID constant_id) {
    pm_buffer_append_format(output_buffer, ":%s", rb_id2name(constant_id));
}

static void
prettyprint_node(pm_buffer_t *output_buffer, const rb_node_t *node, pm_buffer_t *prefix_buffer) {
    switch (RB_NODE_TYPE(node)) {
        case RB_NODE_LAST:
            return;
        <%- nodes.each do |node| -%>
        case <%= node.type %>: {
            <%- if !node.flags.nil? || node.fields.any? -%>
            rb_<%= node.human %>_t *cast = (rb_<%= node.human %>_t *) node;
            <%- end -%>
            pm_buffer_append_string(output_buffer, "@ <%= node.name %> (location: ", <%= node.name.length + 14 %>);
            prettyprint_location(output_buffer, &node->location);
            pm_buffer_append_string(output_buffer, ")", 1);
            if (rb_node_fl_newline(node)) pm_buffer_append_string(output_buffer, "*", 1);
            pm_buffer_append_string(output_buffer, "\n", 1);
            <%- (fields = [*node.flags, *node.fields]).each_with_index do |field, index| -%>
            <%- preadd = index == fields.length - 1 ? "    " : "|   " -%>

            // <%= field.name %>
            {
                pm_buffer_concat(output_buffer, prefix_buffer);
                pm_buffer_append_string(output_buffer, "+-- <%= field.name %>:", <%= 4 + field.name.length + 1 %>);
            <%- case field -%>
            <%- when Prism::Template::NodeField -%>
                pm_buffer_append_byte(output_buffer, '\n');

                size_t prefix_length = prefix_buffer->length;
                pm_buffer_append_string(prefix_buffer, "<%= preadd %>", 4);
                pm_buffer_concat(output_buffer, prefix_buffer);
                prettyprint_node(output_buffer, (rb_node_t *) cast-><%= field.name %>, prefix_buffer);
                prefix_buffer->length = prefix_length;
            <%- when Prism::Template::OptionalNodeField -%>
                if (cast-><%= field.name %> == NULL) {
                    pm_buffer_append_string(output_buffer, " nil\n", 5);
                } else {
                    pm_buffer_append_byte(output_buffer, '\n');

                    size_t prefix_length = prefix_buffer->length;
                    pm_buffer_append_string(prefix_buffer, "<%= preadd %>", 4);
                    pm_buffer_concat(output_buffer, prefix_buffer);
                    prettyprint_node(output_buffer, (rb_node_t *) cast-><%= field.name %>, prefix_buffer);
                    prefix_buffer->length = prefix_length;
                }
            <%- when Prism::Template::StringField -%>
                pm_buffer_append_string(output_buffer, " \"", 2);
                pm_buffer_append_source(output_buffer, cast-><%= field.name %>->ptr, cast-><%= field.name %>->len, PM_BUFFER_ESCAPING_RUBY);
                pm_buffer_append_string(output_buffer, "\"\n", 2);
            <%- when Prism::Template::NodeListField -%>
                pm_buffer_append_format(output_buffer, " (length: %lu)\n", (unsigned long) (cast-><%= field.name %>.size));

                size_t last_index = cast-><%= field.name %>.size;
                for (uint32_t index = 0; index < last_index; index++) {
                    size_t prefix_length = prefix_buffer->length;
                    pm_buffer_append_string(prefix_buffer, "<%= preadd %>", 4);
                    pm_buffer_concat(output_buffer, prefix_buffer);
                    pm_buffer_append_string(output_buffer, "+-- ", 4);
                    pm_buffer_append_string(prefix_buffer, (index == last_index - 1) ? "    " : "|   ", 4);
                    prettyprint_node(output_buffer, (rb_node_t *) cast-><%= field.name %>.nodes[index], prefix_buffer);
                    prefix_buffer->length = prefix_length;
                }
            <%- when Prism::Template::ConstantField -%>
                pm_buffer_append_byte(output_buffer, ' ');
                prettyprint_constant(output_buffer, cast-><%= field.name %>);
                pm_buffer_append_byte(output_buffer, '\n');
            <%- when Prism::Template::OptionalConstantField -%>
                if (cast-><%= field.name %> == 0) {
                    pm_buffer_append_string(output_buffer, " nil\n", 5);
                } else {
                    pm_buffer_append_byte(output_buffer, ' ');
                    prettyprint_constant(output_buffer, cast-><%= field.name %>);
                    pm_buffer_append_byte(output_buffer, '\n');
                }
            <%- when Prism::Template::ConstantListField -%>
                pm_buffer_append_string(output_buffer, " [", 2);
                if (cast-><%= field.name %>) {
                    for (int index = 0; index < cast-><%= field.name %>->size; index++) {
                        if (index != 0) pm_buffer_append_string(output_buffer, ", ", 2);
                        prettyprint_constant(output_buffer, cast-><%= field.name %>->ids[index]);
                    }
                }
                pm_buffer_append_string(output_buffer, "]\n", 2);
            <%- when Prism::Template::LocationField -%>
                rb_code_location_t *location = &cast-><%= field.name %>;
                pm_buffer_append_byte(output_buffer, ' ');
                prettyprint_location(output_buffer, location);
                pm_buffer_append_string(output_buffer, " = \"", 4);
                // pm_buffer_append_source(output_buffer, location->start, (size_t) (location->end - location->start), PM_BUFFER_ESCAPING_RUBY);
                pm_buffer_append_string(output_buffer, "\"\n", 2);
            <%- when Prism::Template::OptionalLocationField -%>
                rb_code_location_t *location = &cast-><%= field.name %>;
                if (NULL_LOC_P(location)) {
                    pm_buffer_append_string(output_buffer, " nil\n", 5);
                } else {
                    pm_buffer_append_byte(output_buffer, ' ');
                    prettyprint_location(output_buffer, location);
                    pm_buffer_append_string(output_buffer, " = \"", 4);
                    // pm_buffer_append_source(output_buffer, location->start, (size_t) (location->end - location->start), PM_BUFFER_ESCAPING_RUBY);
                    pm_buffer_append_string(output_buffer, "\"\n", 2);
                }
            <%- when Prism::Template::UInt8Field -%>
                pm_buffer_append_format(output_buffer, " %" PRIu8 "\n", cast-><%= field.name %>);
            <%- when Prism::Template::UInt32Field -%>
                pm_buffer_append_format(output_buffer, " %" PRIu32 "\n", cast-><%= field.name %>);
            <%- when Prism::Template::Flags -%>
                bool found = false;
                <%- field.values.each do |value| -%>
                if (cast->base.flags & RB_<%= field.human.upcase %>_<%= value.name %>) {
                    if (found) pm_buffer_append_byte(output_buffer, ',');
                    pm_buffer_append_string(output_buffer, " <%= value.name.downcase %>", <%= value.name.bytesize + 1 %>);
                    found = true;
                }
                <%- end -%>
                if (!found) pm_buffer_append_string(output_buffer, " nil", 4);
                pm_buffer_append_byte(output_buffer, '\n');
            <%- when Prism::Template::IntegerField -%>
                const pm_integer_t *integer = &cast-><%= field.name %>;
                pm_buffer_append_byte(output_buffer, ' ');
                pm_integer_string(output_buffer, integer);
                pm_buffer_append_byte(output_buffer, '\n');
            <%- when Prism::Template::DoubleField -%>
                pm_buffer_append_format(output_buffer, " %f\n", cast-><%= field.name %>);
            <%- when Prism::Template::EncodingField -%>
                // TODO
                (void)cast;
                pm_buffer_append_byte(output_buffer, '\n');
            <%- else -%>
            <%- raise -%>
            <%- end -%>
            }
            <%- end -%>

            break;
        }
        <%- end -%>
    }
}

/**
 * Pretty-prints the AST represented by the given node to the given buffer.
 */
PRISM_EXPORTED_FUNCTION void
rb_parser_prettyprint(pm_buffer_t *output_buffer, const rb_node_t *node) {
    pm_buffer_t *prefix_buffer = pm_buffer_new();
    prettyprint_node(output_buffer, node, prefix_buffer);
    pm_buffer_free(prefix_buffer);
}

#endif
