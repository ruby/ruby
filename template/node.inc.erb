#line <%= __LINE__ + 1 %> "templates/<%= File.basename(__FILE__) %>"

/**
 * Returns a string representation of the given node type.
 */
PRISM_EXPORTED_FUNCTION const char *
rb_node_type_to_str(rb_node_type_t node_type)
{
    switch (node_type) {
<%- nodes.each do |node| -%>
        case <%= node.type %>:
            return "<%= node.type %>";
<%- end -%>
    }
    return "";
}

/* Stop at the first child accepted by the visitor. */
bool
rb_node_each_child(const rb_node_t *node, bool (*visit)(const rb_node_t *, void *), void *data)
{
    switch (RB_NODE_TYPE(node)) {
<%- nodes.each do |node| -%>
<%- fields = node.fields.select { |field| field.is_a?(Prism::Template::NodeField) || field.is_a?(Prism::Template::OptionalNodeField) || field.is_a?(Prism::Template::NodeListField) } -%>
<%- next if fields.empty? -%>
      case <%= node.type %>: {
        const rb_<%= node.human %>_t *n = (const rb_<%= node.human %>_t *)node;
<%- fields.each do |field| -%>
<%- if field.is_a?(Prism::Template::NodeListField) -%>
        for (size_t i = 0; i < n-><%= field.name %>.size; i++) {
            if (n-><%= field.name %>.nodes[i] && visit(n-><%= field.name %>.nodes[i], data)) return true;
        }
<%- else -%>
        if (n-><%= field.name %> && visit((const rb_node_t *)n-><%= field.name %>, data)) return true;
<%- end -%>
<%- end -%>
        break;
      }
<%- end -%>
      default: break;
    }
    return false;
}

/* Children and local tables belong to the AST arena; free only owned payloads. */
static void
free_rb_ast_value(rb_ast_t *ast, void *ctx, rb_node_t *node)
{
    switch (node->type) {
<%- nodes.each do |node| -%>
<%- fields = node.fields.select { |field| field.is_a?(Prism::Template::NodeListField) || field.is_a?(Prism::Template::StringField) } -%>
<%- next if fields.empty? -%>
      case <%= node.type %>: {
        rb_<%= node.human %>_t *n = (rb_<%= node.human %>_t *)node;
<%- fields.each do |field| -%>
<%- if field.is_a?(Prism::Template::NodeListField) -%>
        rb_node_list_free(&n-><%= field.name %>);
<%- else -%>
        parser_string_free(ast, n-><%= field.name %>);
<%- end -%>
<%- end -%>
        break;
      }
<%- end -%>
      default:
        break;
    }
}

static size_t
rb_node_payload_memsize(const rb_node_t *node)
{
    size_t size = 0;
    switch (node->type) {
<%- nodes.each do |node| -%>
<%- fields = node.fields.select { |field| field.is_a?(Prism::Template::NodeListField) || field.is_a?(Prism::Template::StringField) } -%>
<%- next if fields.empty? -%>
      case <%= node.type %>: {
        const rb_<%= node.human %>_t *n = (const rb_<%= node.human %>_t *)node;
<%- fields.each do |field| -%>
<%- if field.is_a?(Prism::Template::NodeListField) -%>
        size += n-><%= field.name %>.capacity * sizeof(*n-><%= field.name %>.nodes);
<%- else -%>
        size += parser_string_memsize(n-><%= field.name %>);
<%- end -%>
<%- end -%>
        break;
      }
<%- end -%>
      default:
        break;
    }
    return size;
}
