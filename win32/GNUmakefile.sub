	@echo Creating $@
	@$(file >$@,$(CONFIG_STATUS_CONTENT))

# BOOTSTRAPRUBY is $(MINIRUBY) here even with BASERUBY, so rbconfig.rb
# and fake.rb generation always need $(PREP).
$(RBCONFIG) $(arch)-fake.rb: $(PREP)

miniruby: miniruby$(EXEEXT)

miniruby$(EXEEXT):
	$(ECHO) linking $@
	$(Q) $(PURIFY) $(CC) $(MAINOBJ) $(MINIOBJS) $(COMMONOBJS) $(LIBS) \
		$(OUTFLAG)$@ -link $(LDFLAGS) $(XLDFLAGS)
	@$(RM) miniruby.lib miniruby.exp
	$(Q) .\miniruby.exe -v

miniruby.rc:
	@exit > $@

$(PROGRAM):	$(MAINOBJ) $(LIBRUBY_SO) $(RUBY_INSTALL_NAME).res
ifeq ($(PROGRAM_EXTS),)
	$(ECHO) linking $@
	$(Q) $(PURIFY) $(CC) $(MAINOBJ) $(EXTOBJS) $(RUBY_INSTALL_NAME).res \
		$(OUTFLAG)$@ $(LIBRUBYARG) -link $(LDFLAGS) $(XLDFLAGS)
endif

$(WPROGRAM):	$(MAINOBJ) $(WINMAINOBJ) $(LIBRUBY_SO) $(RUBYW_INSTALL_NAME).res
	$(ECHO) linking $@
	$(Q) $(PURIFY) $(CC) $(MAINOBJ) $(WINMAINOBJ) \
		$(RUBYW_INSTALL_NAME).res $(OUTFLAG)$@ $(LIBRUBYARG) \
		-link $(LDFLAGS) $(XLDFLAGS) -subsystem:Windows

$(STUBPROGRAM):	rubystub.$(OBJEXT) $(LIBRUBY) $(LIBRUBY_SO) $(RUBY_INSTALL_NAME).res
	$(ECHO) linking $@
	$(Q) $(PURIFY) $(CC) rubystub.$(OBJEXT) $(RUBY_INSTALL_NAME).res \
		$(OUTFLAG)$@ $(LIBRUBYARG) -link $(LDFLAGS) $(XLDFLAGS)

ifeq ($(if $(EXTSTATIC),$(LIBRUBY_SO_UPDATE),x),)
PRE_LIBRUBY_UPDATE = $(RM) $(LIBRUBY_EXTS)
else
PRE_LIBRUBY_UPDATE =
endif

$(LIBRUBY_A):	$(OBJS) $(INITOBJS)
	@-$(PRE_LIBRUBY_UPDATE)
	$(ECHO) linking static-library $@
	$(Q) $(AR) $(ARFLAGS)$@ $(OBJS) $(INITOBJS)

$(LIBRUBY):	$(RUBYDEF)
	$(ECHO) linking import-library $@
	$(Q) $(AR) $(ARFLAGS)$@ -def:$(RUBYDEF)

$(LIBRUBY_SO):	$(LIBRUBY_A) $(DLDOBJS) $(RUBYDEF) $(RUBY_SO_NAME).res
	@-$(PRE_LIBRUBY_UPDATE)
	$(ECHO) linking shared-library $@
	$(Q) $(LDSHARED) $(DLDOBJS) $(LIBRUBY_A) \
		$(RUBY_SO_NAME).res $(SOLIBS) $(EXTSOLIBS) $(LIBS) \
		$(OUTFLAG)$@ -link $(LDFLAGS) $(XLDFLAGS) \
		$(LIBRUBY_DLDFLAGS)
	@$(RM) dummy.lib dummy.exp

$(RUBYDEF):	$(LIBRUBY_A) $(DLDOBJS) $(RBCONFIG)
	$(ECHO) generating $@
	$(Q) $(BOOTSTRAPRUBY_COMMAND) $(srcdir)/win32/mkexports.rb \
	  -output=$@ -arch=$(ARCH) $(LIBRUBY_A) -- $(DLDOBJS)

clean-local::
	$(Q)$(RM) $(WINMAINOBJ) ext\extinit.c ext\extinit.$(OBJEXT) ext\vc*.pdb miniruby.lib
	$(Q)$(RM) $(RUBY_INSTALL_NAME).res $(RUBYW_INSTALL_NAME).res $(RUBY_SO_NAME).res
	$(Q)$(RM) miniruby.rc $(RUBY_INSTALL_NAME).rc $(RUBYW_INSTALL_NAME).rc $(RUBY_SO_NAME).rc
	$(Q)$(RM) *.map *.pdb *.ilk *.exp *.dll $(RUBYDEF) ext\ripper\y.output

distclean-local::
	$(Q)$(RM) ext\config.cache $(call win,$(RBCONFIG)) $(call win,$(CONFIG_H)) miniprelude.c
	-$(Q)$(RM) $(call win,$(INSTALLED_LIST)) $(call win,$(arch_hdrdir))\ruby\config.h verconf.h
	-$(Q)$(RM) uncommon.mk
	-$(Q)$(RMDIRS) $(call win,$(arch_hdrdir))\ruby
	-$(Q)$(RMDIR) win32

clean-local:: clean-prism

clean-prism:
	@for /R $(call win,$(PRISM_BUILD_DIR)) %%I in (.time) do @(del /q %%I && $(RMDIRS) %%~pI) 2> nul || $(NULLCMD)

distclean-local:: clean-srcs-local
distclean-ext:: clean-srcs-ext

distclean-local:: distclean-prism

distclean-prism: clean-prism
ifneq ($(srcdir),.)
	$(Q)for %%I in ( \
		$(call win,$(PRISM_SRCDIR))\templates\ext\prism\*.c.erb \
		$(call win,$(PRISM_SRCDIR))\templates\include\prism\*.h.erb \
		$(call win,$(PRISM_SRCDIR))\templates\src\*.c.erb \
	) do $(Q)(del /q prism\%%~nI 2> nul || $(NULLCMD))
	$(Q)for /D %%I in (prism\*) do $(Q)$(RMDIRS) %%I
	$(Q)$(RMDIRS) prism
endif

realclean-prism: distclean-prism
ifeq ($(srcdir),.)
	$(Q)for %%I in ( \
		$(call win,$(PRISM_SRCDIR))\templates\ext\prism\*.c.erb \
		$(call win,$(PRISM_SRCDIR))\templates\include\prism\*.h.erb \
		$(call win,$(PRISM_SRCDIR))\templates\src\*.c.erb \
	) do $(Q)(del /q $(call win,$(PRISM_SRCDIR))\%%~nI 2> nul || $(NULLCMD))
endif

.bundle/clean:: .bundle/clean.sub
.bundle/distclean:: .bundle/distclean.sub
.bundle/realclean:: .bundle/realclean.sub

.bundle/clean.sub:: ext/clean.mk
.bundle/distclean.sub:: ext/distclean.mk
.bundle/realclean.sub:: ext/realclean.mk

# top_srcdir on the command line would override the one in each
# extension's Makefile too, so pass it through the environment.
ext/clean.mk ext/distclean.mk ext/realclean.mk::
	$(Q)if exist $(EXTS_MK) (set "top_srcdir=$(srcdir)" && $(MAKE) -k -f $(EXTS_MK) $(basename $(@F)))

ext/clean.sub ext/distclean.sub ext/realclean.sub \
.bundle/clean.sub .bundle/distclean.sub .bundle/realclean.sub::
	$(Q)cd $(@D) 2>nul && (for /R $(EXTS) %%I in (.) \
	do $(Q)if exist %%I\Makefile ( \
	    cd %%I && ( \
	    call set n=%%I && \
	    call set n=%%n:%CD%\$(@D)\=%% && \
	    call set n=%%n:\.=%% && \
	    call echo $(@F:.sub=)ing %%n:\=/%% & \
	    $(MAKE) $(@F:.sub=) & \
	    cd %CD% & \
	    $(RMDIRS) %%I \
	))) || $(NULLCMD)

ext/distclean ext/realclean .bundle/distclean .bundle/realclean::
	$(Q)(for /D /R $(@D) %%I in (.) do $(Q)$(RMDIRS) %%I) || $(NULLCMD)

.bundle/distclean .bundle/realclean::
	$(Q)for /D %%I in ($(@D)\*) do $(Q)$(RMDIRS) %%I || $(NULLCMD)
	-$(Q)rmdir $(@D) 2> nul || $(NULLCMD)

.bundle/realclean::
	@$(RMALL) $(tooldir)/bunlder/*.lock $(srcdir)/.bundle

gc/clean gc/distclean gc/realclean::
	- for /D %%G in (gc\*) do (pushd %%G && $(MAKE) TARGET_SO_DIR=./ $(@F) & popd) || $(NULLCMD)
gc/distclean gc/realclean::
	- for /D %%G in (gc\*) do ($(RMDIR) %%G) || $(NULLCMD)

clean-enc distclean-enc realclean-enc:
ifneq ($(wildcard $(ENC_MK)),)
	$(ECHO) $(@:-enc=ing) encodings
	-$(Q)$(MAKE) $(MAKE_ENC) $(@:-enc=)
endif

$(RCFILES) &: $(RBCONFIG) $(srcdir)/revision.h $(srcdir)/win32/resource.rb
	@$(BOOTSTRAPRUBY_COMMAND) $(srcdir)/win32/resource.rb \
		-ruby_name=$(RUBY_INSTALL_NAME) \
		-rubyw_name=$(RUBYW_INSTALL_NAME) \
		-so_name=$(RUBY_SO_NAME) \
		. $(icondirs) $(win_srcdir)

$(ruby_pc): $(RBCONFIG)
	@$(BOOTSTRAPRUBY) $(tooldir)/expand-config.rb \
		-output=$@ -mode=$(INSTALL_DATA_MODE) -config=rbconfig.rb \
		$(srcdir)/template/ruby.pc.in

