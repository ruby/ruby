# -*- mode: makefile-gmake; indent-tabs-mode: t -*-
#
# GNU make counterpart of win32/Makefile.sub.  EXPERIMENTAL.
#
# Needs GNU make 4.4 or later built for native Windows, and runs
# recipes with cmd.exe, not sh.

# Native GNU make prefers sh.exe when one is found in PATH.
SHELL := cmd.exe
# Sub-makes would look for sh.exe again, and exporting SHELL does not
# reach them.
MAKEOVERRIDES += SHELL=cmd.exe
# Variable names are case sensitive, and the environment has `ComSpec`.
COMSPEC := $(or $(ComSpec),$(COMSPEC),cmd.exe)

GNUMAKEFLAGS += --output-sync=target

gnumake = yes
nmake =
DOT_WAIT = .WAIT
override order_only := |
override gnumake_recursive := +
# The GNU make versions of update-gems and extract-gems in defs/gmake.mk
# need sh, so keep the portable ones in common.mk under these names.
override sequential :=

ECHO1 = $(V:1=@:)
RUNCMD = $(COMSPEC) /c
MKFILES = GNUmakefile verconf.mk
NULLCMD = exit /b0.
NULL = nul
CHDIR = cd
PATH_SEPARATOR = ;
TZ =
PWD := $(CURDIR)
MAKEDIR := $(subst /,\,$(CURDIR))
empty =
tooldir = $(srcdir)/tool
win = $(subst /,\,$(1))
comma = ,
sharp = \#
define newline


endef

