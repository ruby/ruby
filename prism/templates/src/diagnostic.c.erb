#include "prism/internal/diagnostic.h"

#include "prism/compiler/assume.h"
#include "prism/compiler/inline.h"
#include "prism/compiler/unused.h"

#include "prism/internal/arena.h"
#include "prism/internal/assert.h"
#include "prism/internal/buffer.h"
#include "prism/internal/list.h"

#include <stdint.h>
#include <string.h>

#define PM_DIAGNOSTIC_ID_MAX <%= errors.length + warnings.length %>
<%- formatted = diagnostics.reject { |diagnostic| diagnostic.signature.empty? } -%>
<%- format_indices = formatted.each_with_index.to_h { |diagnostic, index| [diagnostic, index + 1] } -%>
<%- raise if formatted.length > 255 -%>
<%- raise if formatted.any? { |diagnostic| diagnostic.literal_ends.last > 255 } -%>

typedef enum {
    PM_DIAGNOSTIC_SIGNATURE_NONE,
    <%- diagnostic_signatures.each do |signature| -%>
    PM_DIAGNOSTIC_SIGNATURE_<%= signature.name.upcase %>,
    <%- end -%>
} pm_diagnostic_signature_t;

typedef enum {
    PM_DIAGNOSTIC_BYTE,
    PM_DIAGNOSTIC_HEX,
    PM_DIAGNOSTIC_HEX2
} pm_diagnostic_byte_format_t;

typedef struct {
    uint8_t level;
    uint8_t format_idx; /* Index into diagnostic_formats */
} pm_diagnostic_metadata_t;

/* Keep message pointers separate so their alignment does not pad every entry. */
static const char *const diagnostic_messages[PM_DIAGNOSTIC_ID_MAX] = {
    <%- diagnostics.each do |diagnostic| -%>
    [<%= diagnostic.id %>] = <%= diagnostic.c_message %>,
    <%- end -%>
};

static const pm_diagnostic_metadata_t diagnostic_metadata[PM_DIAGNOSTIC_ID_MAX] = {
    <%- diagnostics.each do |diagnostic| -%>
    [<%= diagnostic.id %>] = { <%= diagnostic.level %>, <%= format_indices.fetch(diagnostic, 0) %> },
    <%- end -%>
};

typedef struct {
    uint8_t signature;
    uint8_t literal_ends[<%= formatted.map { |diagnostic| diagnostic.literals.length }.max %>]; /* End offset of each literal piece in a formatted message. */
    uint8_t byte_formats[<%= formatted.map { |diagnostic| diagnostic.byte_formats.length }.max %>];
} pm_diagnostic_format_t;

static const pm_diagnostic_format_t diagnostic_formats[] = {
    {
        .signature = PM_DIAGNOSTIC_SIGNATURE_NONE
    },
    <%- formatted.each do |diagnostic| -%>
    [<%= format_indices.fetch(diagnostic) %>] = {
        .signature = PM_DIAGNOSTIC_SIGNATURE_<%= diagnostic.signature.join("_").upcase %>,
        .literal_ends = { <%= diagnostic.literal_ends.join(", ") %> },
        <%- unless diagnostic.byte_formats.empty? -%>
        .byte_formats = { <%= diagnostic.byte_formats.map { |format| "PM_DIAGNOSTIC_#{format.upcase}" }.join(", ") %> },
        <%- end -%>
    },
    <%- end -%>
};

/**
 * Get the human-readable name of the given diagnostic ID.
 */
static const char *
pm_diagnostic_id_name(pm_diagnostic_id_t diag_id) {
    switch (diag_id) {
        <%- errors.each do |error| -%>
        case PM_ERR_<%= error.name %>: return "<%= error.name.downcase %>";
        <%- end -%>
        <%- warnings.each do |warning| -%>
        case PM_WARN_<%= warning.name %>: return "<%= warning.name.downcase %>";
        <%- end -%>
    }

    PRISM_ASSERT(false && "unreachable");
    return "";
}

static PRISM_INLINE const pm_diagnostic_format_t *
pm_diagnostic_format(pm_diagnostic_id_t diag_id, PRISM_UNUSED pm_diagnostic_signature_t signature) {
    PRISM_ASSERT(diag_id < PM_DIAGNOSTIC_ID_MAX);
    PRISM_ASSUME(diag_id < PM_DIAGNOSTIC_ID_MAX);

    const pm_diagnostic_format_t *format = &diagnostic_formats[diagnostic_metadata[diag_id].format_idx];
    PRISM_ASSERT(format->signature == signature);
    return format;
}

/**
 * Get the type of the given diagnostic.
 */
const char *
pm_diagnostic_type(const pm_diagnostic_t *diagnostic) {
    return pm_diagnostic_id_name(diagnostic->diag_id);
}

/**
 * Get the location of the given diagnostic.
 */
pm_location_t
pm_diagnostic_location(const pm_diagnostic_t *diagnostic) {
    return diagnostic->location;
}

/**
 * Get the message of the given diagnostic.
 */
const char *
pm_diagnostic_message(const pm_diagnostic_t *diagnostic) {
    return diagnostic->message;
}

/**
 * Get the error level associated with the given diagnostic.
 */
pm_error_level_t
pm_diagnostic_error_level(const pm_diagnostic_t *diagnostic) {
    return (pm_error_level_t) diagnostic->level;
}

/**
 * Get the warning level associated with the given diagnostic.
 */
pm_warning_level_t
pm_diagnostic_warning_level(const pm_diagnostic_t *diagnostic) {
    return (pm_warning_level_t) diagnostic->level;
}

/**
 * Get the diagnostic that follows the given diagnostic.
 */
const pm_diagnostic_t *
pm_diagnostic_next(const pm_diagnostic_t *diagnostic) {
    return (const pm_diagnostic_t *) diagnostic->node.next;
}

/* Store a diagnostic whose message is static or already in the arena. */
static void
pm_diagnostic_list_append_message(pm_arena_t *arena, pm_list_t *list, uint32_t start, uint32_t length, pm_diagnostic_id_t diag_id, const char *message) {
    pm_diagnostic_t *diagnostic = PM_ARENA_ZALLOC(arena, pm_diagnostic_t);

    *diagnostic = (pm_diagnostic_t) {
        .location = { .start = start, .length = length },
        .diag_id = diag_id,
        .message = message,
        .level = diagnostic_metadata[diag_id].level
    };

    pm_list_append(list, (pm_list_node_t *) diagnostic);
}

/* A diagnostic without substitutions can refer directly to its static text. */
void
pm_diagnostic_list_append(pm_arena_t *arena, pm_list_t *list, uint32_t start, uint32_t length, pm_diagnostic_id_t diag_id) {
    PRISM_ASSERT(diag_id < PM_DIAGNOSTIC_ID_MAX && diagnostic_metadata[diag_id].format_idx == 0);
    pm_diagnostic_list_append_message(arena, list, start, length, diag_id, diagnostic_messages[diag_id]);
}

/* Render a byte either as a character or as uppercase hexadecimal digits. */
static pm_string_t
pm_diagnostic_render_byte(pm_diagnostic_byte_format_t format, const uint8_t *byte, char digits[2]) {
    if (format == PM_DIAGNOSTIC_BYTE) {
        return (pm_string_t) { .source = byte, .length = 1 };
    }

    pm_buffer_hexadecimal_byte_digits(*byte, digits);
    size_t offset = (format == PM_DIAGNOSTIC_HEX && *byte < 16) ? 1 : 0;

    return (pm_string_t) { .source = (const uint8_t *) digits + offset, .length = 2 - offset };
}

static pm_string_t
pm_diagnostic_render_line(int32_t line, char digits[11]) {
    uint8_t length = pm_buffer_line_number_digits(line, digits);

    return (pm_string_t) { .source = (const uint8_t *) digits + 11 - length, .length = length };
}

/* Interleave the literal pieces with the arguments in one arena allocation. */
static char *
pm_diagnostic_render_message(pm_arena_t *arena, const char *literals, const pm_diagnostic_format_t *format, const pm_string_t *args, size_t count) {
    size_t size = (size_t) format->literal_ends[count] + 1;
    for (size_t index = 0; index < count; index++) {
        if (args[index].length > SIZE_MAX - size) pm_arena_alloc_overflow();
        size += args[index].length;
    }

    char *message = PM_ARENA_ALLOC_ARRAY(arena, char, size);
    char *cursor = message;
    size_t offset = 0;

    for (size_t index = 0; index < count; index++) {
        size_t end = format->literal_ends[index];
        memcpy(cursor, literals + offset, end - offset);

        cursor += end - offset;
        offset = end;

        if (args[index].length) {
            memcpy(cursor, args[index].source, args[index].length);
            cursor += args[index].length;
        }
    }

    /* The final literal includes the terminating NUL. */
    memcpy(cursor, literals + offset, (size_t) format->literal_ends[count] - offset + 1);
    return message;
}
<%- diagnostic_signatures.each do |signature| -%>

void
pm_diagnostic_list_append_<%= signature.name %>(pm_arena_t *arena, pm_list_t *list, uint32_t start, uint32_t length, pm_diagnostic_id_t diag_id, <%= signature.parameters %>) {
    const pm_diagnostic_format_t *format = pm_diagnostic_format(diag_id, PM_DIAGNOSTIC_SIGNATURE_<%= signature.name.upcase %>);

    <%- signature.types.each_with_index do |type, index| -%>
    <%- if type == "byte" -%>
    char digits<%= index %>[2];
    <%- elsif type == "line" -%>
    char digits<%= index %>[11];
    <%- end -%>
    <%- end -%>
    const pm_string_t args[] = {
        <%- signature.types.each_with_index do |type, index| -%>
        <%- case type -%>
        <%- when "slice" -%>
        arg<%= index %>,
        <%- when "line" -%>
        pm_diagnostic_render_line(arg<%= index %>, digits<%= index %>),
        <%- when "byte" -%>
        pm_diagnostic_render_byte(format->byte_formats[<%= signature.types.take(index).count("byte") %>], &arg<%= index %>, digits<%= index %>),
        <%- end -%>
        <%- end -%>
    };

    char *message = pm_diagnostic_render_message(arena, diagnostic_messages[diag_id], format, args, <%= signature.types.length %>);
    pm_diagnostic_list_append_message(arena, list, start, length, diag_id, message);
}
<%- end -%>
